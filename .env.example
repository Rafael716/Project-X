# Project X — plantilla de configuración (Unidad 3: configuración externalizada).
# Copia este archivo a `.env` y ajusta. NO commitees tu `.env` (va en .gitignore).
# Todas las variables tienen default en backend/config.py; esto solo las sobreescribe.

# --- red / runtime ---
PORT=8787
PX_TICK_SEG=0.25
PX_LOG_LEVEL=INFO
PX_LANG=es                 # es | en  (idioma de los mensajes al jugador, i18n)

# --- Diseño por Contrato (Sesión 3) ---
PX_CONTRATOS=1             # 1 = verifica invariantes en cada tick; 0 = los desactiva

# --- perillas de balance (calibración del juego) ---
PX_ENERGIA_MAX=10
PX_ENERGIA_REGEN=1
PX_PUNTOS_META=300
PX_DETECTOR_UMBRAL=0.6

# --- contrapresión / backpressure (Sesión 7) ---
PX_BP_CAP=12
PX_BP_RPS=8

# --- feature flags: activan/desactivan capacidades sin recompilar ---
PX_FEATURE_HONEYPOT=1
PX_FEATURE_CANARY=1
PX_FEATURE_PHISHING=1
PX_FEATURE_NIVEL_DIFICIL=1   # 0 oculta el escenario DATACENTER-02
